{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "skipLibCheck": true,

    
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    
    /* JSX Ayarı - KIRMIZI ÇİZGİLERİ YOK EDECEK OLAN KISIM */
    "jsx": "react-jsx",

    
    "strict": true
  },
  "include": ["src"]
}